# Node 24+ server. Copy to .env; never commit the real .env.
# Omit ADMIN_PASSWORD locally to generate data/organizer-key.txt automatically.
ADMIN_PASSWORD=
PORT=3000
HOST=127.0.0.1
DATA_DIR=data
# Optional Telegram: all three, plus a PUBLIC HTTPS webhook.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
